# Copia questo file in .env e riempi i valori. NON committare mai .env.
# Il repo traderLab non contiene e non deve contenere chiavi di wallet.

# Unica credenziale usata dal Lab: la API key Anthropic per il Trader.
ANTHROPIC_API_KEY=

# Smoke test con API reale: disattivato di default.
# Impostare a 1 SOLO per eseguire manualmente tests/test_live_smoke.py.
TRADERLAB_ALLOW_LIVE_API=0

# Rete pubblica per la COSTRUZIONE dello snapshot (mai durante le decisioni).
# Impostare a 1 solo quando si esegue scripts/build_snapshot.py contro Hyperliquid.
TRADERLAB_ALLOW_NETWORK=0
