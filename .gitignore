.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Dati generati a runtime: snapshot congelati, ledger, log dei tool.
data/snapshots/*
!data/snapshots/.gitkeep
data/ledger/*
!data/ledger/.gitkeep
data/toolcalls/*
!data/toolcalls/.gitkeep
data/logs/*
!data/logs/.gitkeep

.idea/

# Report e prompt di lavoro generati a mano/da rito: non fanno parte del track record.
*_REPORT.md
PROMPT_*.md
REPORT_*.md

# Materiale grezzo di lavoro (elicitation, script usa-e-getta, log di corsa).
scratchpad/
